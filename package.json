{
  "name": "casework",
  "private": true,
  "description": "Track-agnostic operations agent for the Real-World Agents Hackathon",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @casework/web dev",
    "demo": "pnpm --filter @casework/web exec next dev -p 3100",
    "build": "pnpm --filter @casework/web build",
    "start": "pnpm --filter @casework/web start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "reality": "pnpm --filter @casework/cli reality",
    "replay": "pnpm --filter @casework/cli replay",
    "eval": "pnpm --filter @casework/cli eval",
    "harness": "pnpm --filter @casework/cli harness",
    "bench": "pnpm --filter @casework/agents bench",
    "answer": "pnpm --filter @casework/agents answer",
    "email:setup": "node --no-warnings scripts/email-setup.ts",
    "tunnel": "bash scripts/tunnel.sh",
    "voice:setup": "node scripts/voice-setup.mts",
    "voice:call": "node scripts/voice-call.mts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
