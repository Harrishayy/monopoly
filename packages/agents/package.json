{
  "name": "@casework/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Both case agents (A: guarded tool loop in @casework/core; B: fixed pipeline), one bench and one CLI",
  "bin": {
    "agents": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "answer": "tsx --env-file-if-exists=../../.env src/cli.ts answer",
    "bench": "tsx --env-file-if-exists=../../.env src/cli.ts bench",
    "judge": "tsx --env-file-if-exists=../../.env src/cli.ts judge",
    "split": "tsx src/cli.ts split",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@casework/core": "workspace:*",
    "@casework/tracks": "workspace:*",
    "@anthropic-ai/sdk": "^0.133.0",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
