# Copy to .env and fill in. Never commit .env.

# Required
ANTHROPIC_API_KEY=

# Models (override per experiment)
MODEL_DECIDE=claude-opus-5-5
MODEL_FAST=claude-haiku-4-5-20251001

# Voice (only needed for the voice agent)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Data and storage
DATA_DIR=./data
DB_PATH=./.casework/casework.db

# Active track: claims | property | banking | logistics
TRACK=property

# Reality Test runner
REALITY_CONCURRENCY=6
TOOL_TIMEOUT_MS=8000
