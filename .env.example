# Copy to .env and fill in. Never commit .env.

# Required
ANTHROPIC_API_KEY=

# Models (override per experiment)
MODEL_DECIDE=claude-haiku-5-5
# Which agent the product and `pnpm reality` run: d (default), a or b
ENGINE=d
# Agent D: voters (follow the shared model), gated supervisor, votes, effort, caps and per-case deadline
AGENT_D_SUPERVISOR_MODEL=claude-opus-5-5
AGENT_D_SAMPLES=3
AGENT_D_EFFORT=high
AGENT_D_SUPERVISOR=on
AGENT_D_SUPERVISOR_MAX_CALLS=200
AGENT_D_SUPERVISOR_MAX_USD=25
AGENT_D_CASE_TIMEOUT_MS=240000
MODEL_FAST=claude-haiku-5-5

# Voice (ElevenLabs tenant line). Only the API key is set by hand; `pnpm tunnel` (or
# `pnpm voice:setup`) creates the agent, its log_issue tool and the post-call webhook, and writes the rest.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_TOOL_ID=
ELEVENLABS_WEBHOOK_ID=
# HMAC secret for the post-call webhook; unsigned webhooks are accepted when empty
ELEVENLABS_WEBHOOK_SECRET=
# Optional: voice (default Alice, British) and the LLM the voice agent runs on
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM=gemini-2.5-flash
# Public https URL of this app (Cloudflare quick tunnel, written by `pnpm tunnel`). Without it the
# in-call tool and webhook can't reach localhost; the conversations poller still files finished calls.
PUBLIC_URL=
# Name the voice agent and tenant portal use; support address shown on the portal
AGENCY_NAME=Northgate Lettings
SUPPORT_EMAIL=

# Email channel (AgentMail: free, 3 inboxes / 3,000 emails a month, no domain or tunnel needed)
# Get a key at https://console.agentmail.to (or: pnpm email:setup --signup you@example.com),
# then run pnpm email:setup to create the inbox and fill AGENTMAIL_INBOX.
AGENTMAIL_API_KEY=
# Inbox id / address, e.g. casework-lettings@agentmail.to (written by pnpm email:setup)
AGENTMAIL_INBOX=
# Optional: username and display name pnpm email:setup asks for; poll interval in ms
AGENTMAIL_USERNAME=casework-lettings
AGENTMAIL_DISPLAY_NAME=Casework Lettings
EMAIL_POLL_MS=10000

# Data and storage
# Case folders: data/public (organisers' examples, git submodule) or data/challenges (Reality Test)
DATA_DIR=./data/public
# outcomes = hide how example cases ended (default); none = load cases exactly as supplied
DATA_WITHHOLD=outcomes
# Outside the repo on purpose: a database inside the watched workspace makes `next dev` reload in a loop.
DB_PATH=~/.casework/casework.db

# Active track: claims | property | banking | logistics
TRACK=property

# Reality Test runner
REALITY_CONCURRENCY=6
TOOL_TIMEOUT_MS=8000

# Inbox: live cases only by default. "show" also lists the example cases from DATA_DIR.
INBOX_EXAMPLES=

# Demo: put real inboxes on the seeded tenant (Alex Demo) and their landlord, so matches and approved sends are visible.
DEMO_TENANT_EMAIL=
DEMO_TENANT_PHONE=
DEMO_LANDLORD_EMAIL=
