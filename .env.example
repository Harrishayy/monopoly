# Copy to .env and fill in. Never commit .env.

# Required
ANTHROPIC_API_KEY=

# Models (override per experiment)
MODEL_DECIDE=claude-haiku-5-5
# Which agent the product and `pnpm reality` run: d (default), a, b or c
ENGINE=d
# Shared model for agents A and B, agent C's read stage and agent D's voters (default claude-haiku-5-5)
# AGENTS_MODEL=claude-haiku-5-5
# SDK retries on rate limits and overload for agent A's calls
# MODEL_MAX_RETRIES=8
# Agent D: voters (follow the shared model), gated supervisor, votes, effort, caps and per-case deadline
AGENT_D_SUPERVISOR_MODEL=claude-opus-5-5
AGENT_D_SAMPLES=3
AGENT_D_EFFORT=high
AGENT_D_SUPERVISOR=on
AGENT_D_SUPERVISOR_MAX_CALLS=200
AGENT_D_SUPERVISOR_MAX_USD=25
AGENT_D_CASE_TIMEOUT_MS=240000
# AGENT_D_MODEL=claude-haiku-5-5
# Output budget per call, thinking included (doubled once on a max_tokens stop)
# AGENT_D_MAX_TOKENS=32000
# AGENT_D_SUPERVISOR_MAX_TOKENS=64000
# Cost estimates only: JSON {"model": [input, output]} USD per million tokens
# AGENT_D_PRICES=

# Agent B (fixed pipeline): per-stage models (default claude-haiku-5-5); off drops the domain manuals
# AGENT_B_MODEL_READ=
# AGENT_B_MODEL_DECIDE=
# AGENT_B_MODEL_CRITIC=
# AGENT_B_MODEL_FALLBACK=
# AGENT_B_MANUALS=on
# Drafts the messages that carry out a person's decision on an escalated live case
# FOLLOWTHROUGH_MODEL=claude-haiku-5-5
MODEL_FAST=claude-haiku-5-5
# Agent C: model per stage, and its refinements to the property manual (off to drop them)
AGENT_C_MODEL_READ=claude-haiku-5-5
AGENT_C_MODEL_DECIDE=claude-opus-5-5
AGENT_C_MODEL_CRITIC=claude-sonnet-5-5
AGENT_C_ADDENDUM=on
# Eval judge (pnpm harness). Opus is the reference; Sonnet with medium effort costs far less and is noisier.
MODEL_JUDGE=claude-opus-5-5
JUDGE_EFFORT=high
JUDGE_SAMPLES=1
JUDGE_CONCURRENCY=4
JUDGE_FALLBACKS=on
# api (default, needs ANTHROPIC_API_KEY) or claude-code (`claude -p` on the logged-in plan; no API credit).
EVAL_BACKEND=api
# Optional path when `claude` is not on PATH
CLAUDE_CODE_BIN=claude

# Voice (ElevenLabs tenant line). Only the API key is set by hand; `pnpm tunnel` (or
# `pnpm voice:setup`) creates the agent, its log_issue tool and the post-call webhook, and writes the rest.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_TOOL_ID=
ELEVENLABS_WEBHOOK_ID=
# HMAC secret for the post-call webhook; unsigned webhooks are accepted when empty
ELEVENLABS_WEBHOOK_SECRET=
# Optional: voice (default Alice, British) and the LLM the voice agent runs on
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM=gemini-2.5-flash
# Public https URL of this app (Cloudflare quick tunnel, written by `pnpm tunnel`). Without it the
# in-call tool and webhook can't reach localhost; the conversations poller still files finished calls.
PUBLIC_URL=
# Optional: your free static ngrok domain (dashboard.ngrok.com → Domains), used by `pnpm tunnel:ngrok`
NGROK_DOMAIN=
# Name the voice agent and tenant portal use; support address shown on the portal
AGENCY_NAME=Northgate Lettings
SUPPORT_EMAIL=

# Email channel (AgentMail: free, 3 inboxes / 3,000 emails a month, no domain or tunnel needed)
# Get a key at https://console.agentmail.to (or: pnpm email:setup --signup you@example.com),
# then run pnpm email:setup to create the inbox and fill AGENTMAIL_INBOX.
AGENTMAIL_API_KEY=
# Inbox id / address, e.g. casework-lettings@agentmail.to (written by pnpm email:setup)
AGENTMAIL_INBOX=
# Optional: username and display name pnpm email:setup asks for; poll interval in ms
AGENTMAIL_USERNAME=casework-lettings
AGENTMAIL_DISPLAY_NAME=Casework Lettings
EMAIL_POLL_MS=10000
# AGENTMAIL_API_URL=https://api.agentmail.to/v0

# Data and storage
# Case folders: data/public (organisers' examples, git submodule) or data/challenges (Reality Test)
DATA_DIR=./data/public
# outcomes = hide how example cases ended (default); none = load cases exactly as supplied
DATA_WITHHOLD=outcomes
# Outside the repo on purpose: a database inside the watched workspace makes `next dev` reload in a loop.
DB_PATH=~/.casework/casework.db

# Active track: claims | property | banking | logistics
TRACK=property

# Reality Test runner
REALITY_CONCURRENCY=6
TOOL_TIMEOUT_MS=8000
# CASEWORK_CASE_ROOT, CASEWORK_CASE_DIR and CASEWORK_OUT_DIR are set by the eval harness for the
# processes it starts; don't set them by hand.

# Inbox: live cases only by default. "show" also lists the example cases from DATA_DIR.
INBOX_EXAMPLES=

# Demo: put real inboxes on the seeded tenant (Alex Demo) and their landlord, so matches and approved sends are visible.
DEMO_TENANT_EMAIL=
DEMO_TENANT_PHONE=
DEMO_LANDLORD_EMAIL=

# Twilio (optional). Lets `pnpm voice:call` ring DEMO_TENANT_PHONE from the ElevenLabs agent.
# Trial is enough: Account SID + Auth Token from the Twilio console, plus the trial number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Written by `pnpm voice:call` after the number is imported into ElevenLabs
ELEVENLABS_PHONE_NUMBER_ID=
